# DATABASE
DATABASE_USER=CHANGE_ME_DB_USER
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_NAME=CHANGE_ME_DB_NAME
DATABASE_HOST=localhost
DATABASE_PORT=5432

# PRISMA
DATABASE_URL="postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@localhost:5432/CHANGE_ME_DB_NAME"
RUN_SEEDERS=true

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT
SECRET_PASSPORT=CHANGE_ME_JWT_SECRET_KEY

# AZURE STORAGE (opcional - dejar vacío si no se usa)
AZURE_STORAGE_CONNECTION_STRING=

# AZURE DOCUMENT INTELLIGENCE (opcional - dejar vacío si no se usa)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# OPENAI (opcional - dejar vacío si no se usa)
OPENAI_API_URL=
OPENAI_API_KEY=
# Modelo del proveedor compatible con OpenAI (por defecto gpt-5-mini).
# Sin URL/clave, la IA pedagógica usa las plantillas oficiales integradas.
OPENAI_MODEL=

# SMTP (correo) - dejar vacío para modo stub (loguea en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Uapaverse <no-reply@uapaverse.edu>
FRONTEND_URL=http://localhost:5173

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=abiezer.reyes952@gmail.com
# SMTP_PASSWORD=hscb yrzo kbua qfvx
# MAIL_FROM=Uapaverse <abiezer.reyes952@gmail.com>
# FRONTEND_URL=http://localhost:5173

# APP
PORT=3000

# SEED (Docker dev) - true: corre `pnpm run db:seed` solo al arrancar
# el contenedor (idempotente, no duplica). false: no seder.
# Solo aplica en Docker (entrypoint); en local con pnpm se ignora.



# APP
PORT=3000

# EDUCRAFT
# Zona horaria del centro (clases de hoy, agenda)
APP_TIMEZONE=America/Santo_Domingo
# true: crea el docente de demostración docente@educraft.app / Educraft2025!
SEED_DEMO=false
