# APP
PORT=3000

# SEED (Docker dev) - true: corre `pnpm run db:seed` solo al arrancar
# el contenedor (idempotente, no duplica). false: no seder.
# Solo aplica en Docker (entrypoint); en local con pnpm se ignora.


# ══════════════════════════════════════════════
# MESA DE POKER — RIVALES CON IA (todo opcional)
# ══════════════════════════════════════════════
# Con POKER_AI_ENABLED=false (o sin la variable) la mesa juega con los bots
# del motor `@poker/engine`, que es el comportamiento por defecto y no
# necesita nada más. Poniendo true, los rivales piden su jugada a un modelo.
POKER_AI_ENABLED=false

# Proveedor: llamacpp | ollama | lmstudio | openai | openrouter | groq | anthropic | custom
POKER_AI_PROVIDER=llamacpp

# URL base de la API (sin /chat/completions). Valores típicos:
#   llama.cpp (llama-server)  → http://127.0.0.1:8080/v1
#   Ollama                    → http://127.0.0.1:11434/v1
#   LM Studio                 → http://127.0.0.1:1234/v1
#   OpenAI                    → https://api.openai.com/v1
#   Groq                      → https://api.groq.com/openai/v1
#   OpenRouter                → https://openrouter.ai/api/v1
#   Anthropic                 → https://api.anthropic.com/v1
POKER_AI_BASE_URL=http://127.0.0.1:8080/v1

# Clave de API. Los servidores locales (llama.cpp, Ollama, LM Studio) no la
# necesitan: déjala vacía. Los proveedores de pago sí la exigen.
POKER_AI_API_KEY=

# Modelo. En llama.cpp puede ser cualquier cosa (el servidor sirve el GGUF
# que se le cargó al arrancar); en las APIs de pago debe ser el ID real.
POKER_AI_MODEL=local-model

# Ajuste fino
POKER_AI_TEMPERATURE=0.6
POKER_AI_MAX_TOKENS=320
POKER_AI_TIMEOUT_MS=12000
# Pide JSON estricto al proveedor. Ponlo en false si tu servidor local no
# soporta response_format (la respuesta se sigue interpretando igual).
POKER_AI_JSON_MODE=true
# Cuántos rivales mueve la IA como máximo; el resto sigue con bots.
POKER_AI_MAX_SEATS=8
# Si la IA falla o tarda, la mano continúa con la heurística local.
POKER_AI_FALLBACK_TO_BOTS=true
# Techo de peticiones por usuario y minuto (protege factura y CPU).
POKER_AI_REQUESTS_PER_MINUTE=120

# ══════════════════════════════════════════════
# BANCO DE PREGUNTAS — GENERACIÓN CON IA (todo opcional)
# ══════════════════════════════════════════════
# Usa el mismo proveedor, modelo y clave de arriba (POKER_AI_*): con la IA
# apagada, la página de preguntas funciona solo con el banco sembrado.
# Solo ADMIN y SUPERADMIN ven el generador. Lo generado NO se guarda solo:
# el administrador elige qué preguntas entran en la base (origen AI) y si
# entran publicadas o como borrador.
# Aquí va solo lo que cambia para esta tarea: una tanda de preguntas pide
# bastantes más tokens y tiempo que una jugada.
QUIZ_AI_MAX_TOKENS=2400
QUIZ_AI_TIMEOUT_MS=60000
QUIZ_AI_TEMPERATURE=0.8
# Tope de preguntas por petición (máximo 30).
QUIZ_AI_MAX_QUESTIONS=10

# ─── Pagos / suscripciones ───────────────────
# Sin estas variables (o vacías) los pagos van en MODO SIMULADO:
# el checkout completa la compra sin cobrar y activa la suscripción.
# PAYMENTS_LIVE=true o PAYMENTS_PROVIDER=... activan los pagos reales;
# mientras la pasarela no esté integrada, el checkout NO completa compras.
PAYMENTS_LIVE=false
# stripe | paypal | google (vacío = ninguna)
PAYMENTS_PROVIDER=
