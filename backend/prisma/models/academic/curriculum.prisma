// ======================================================
// CURRÍCULO — Adecuación Curricular de Matemática
// (MINERD, Nivel Secundario). Catálogo global consultable
// por los docentes y editable por quienes tengan el permiso
// `curriculum:manage`. Se siembra con
// `prisma/seeders/curriculum.seeder.ts`.
// ======================================================

/// Eje transversal de la Adecuación, definido por ciclo.
/// Los cinco ejes del documento se asocian a cada ciclo y
/// conservan los enunciados por grado en `gradeDetails`.
model CrossCuttingAxis {
  id           Int      @id @default(autoincrement())
  code         String   @db.VarChar(40) // SALUD_BIENESTAR, ...
  name         String   @db.VarChar(120) // "Salud y Bienestar"
  cycle        Int // 1 = Primer Ciclo, 2 = Segundo Ciclo
  description  String   @db.Text // síntesis del eje en el ciclo
  gradeDetails String[] // enunciados por grado: "1ro: …"
  order        Int      @default(0)

  @@unique([code, cycle])
  @@index([cycle])
}

/// Capacidad derivada de una competencia específica de un grado.
model Capacity {
  id                   Int    @id @default(autoincrement())
  code                 String @unique @db.VarChar(80) // SEC-1-COMUNICATIVA
  gradeId              Int
  specificCompetenceId Int
  description          String @db.Text
  order                Int    @default(0)

  grade              CurriculumGrade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  specificCompetence SpecificCompetence @relation(fields: [specificCompetenceId], references: [id], onDelete: Cascade)
  performances       Performance[]

  @@index([gradeId])
  @@index([specificCompetenceId])
}

/// Desempeño esperado (logro) asociado a una capacidad.
model Performance {
  id          Int    @id @default(autoincrement())
  code        String @unique @db.VarChar(100) // SEC-1-COMUNICATIVA-01
  gradeId     Int
  capacityId  Int
  description String @db.Text
  order       Int    @default(0)

  grade    CurriculumGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  capacity Capacity        @relation(fields: [capacityId], references: [id], onDelete: Cascade)

  @@index([gradeId])
  @@index([capacityId])
}

/// Grado del Nivel Secundario (1ro a 6to).
model CurriculumGrade {
  id    Int     @id @default(autoincrement())
  code  String  @unique @db.VarChar(20) // SEC-1 … SEC-6
  name  String  @db.VarChar(80) // "1ro de Secundaria"
  level String  @default("SECUNDARIA") @db.VarChar(30)
  cycle Int // 1 = Primer Ciclo, 2 = Segundo Ciclo
  order Int
  /// Énfasis del grado (p.ej. "Números racionales").
  focus String? @db.Text

  specificCompetences SpecificCompetence[]
  indicators          AchievementIndicator[]
  contents            CurriculumContent[]
  sections            Section[]
  units               LearningUnit[]
  lessonPlans         LessonPlan[]
  questions           Question[]
  exams               Exam[]
  instruments         EvaluationInstrument[]
  activities          InteractiveActivity[]
  capacities          Capacity[]
  performances        Performance[]
}

/// Competencia fundamental del currículo dominicano.
/// `gradingBlock` agrupa las 7 competencias en los 4 bloques
/// del registro oficial de calificaciones (PC1…PC4).
model FundamentalCompetence {
  id           Int    @id @default(autoincrement())
  code         String @unique @db.VarChar(40)
  name         String @db.VarChar(120)
  shortName    String @db.VarChar(40) // Etiqueta corta para gráficos
  gradingBlock Int
  order        Int

  specificCompetences SpecificCompetence[]
  indicators          AchievementIndicator[]
  criteria            EvaluationCriterion[]
  assessments         Assessment[]
  questions           Question[]
  exams               Exam[]
  instruments         EvaluationInstrument[]
}

/// Competencia específica de un grado para una competencia fundamental.
model SpecificCompetence {
  id            Int    @id @default(autoincrement())
  gradeId       Int
  fundamentalId Int
  description   String @db.Text

  grade       CurriculumGrade       @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  fundamental FundamentalCompetence @relation(fields: [fundamentalId], references: [id], onDelete: Cascade)
  capacities  Capacity[]

  @@unique([gradeId, fundamentalId])
}

/// Indicador de logro de un grado.
model AchievementIndicator {
  id            Int    @id @default(autoincrement())
  gradeId       Int
  fundamentalId Int?
  description   String @db.Text
  order         Int    @default(0)

  grade       CurriculumGrade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  fundamental FundamentalCompetence? @relation(fields: [fundamentalId], references: [id], onDelete: SetNull)

  @@index([gradeId])
}

/// Contenido (conceptual, procedimental o actitudinal) de un grado.
model CurriculumContent {
  id          Int         @id @default(autoincrement())
  gradeId     Int
  kind        ContentKind
  block       String?     @db.VarChar(80) // "Numeración", "Álgebra", "Geometría"…
  description String      @db.Text
  order       Int         @default(0)

  grade CurriculumGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId, kind])
}

/// Criterio de evaluación del ciclo para una competencia fundamental.
model EvaluationCriterion {
  id            Int    @id @default(autoincrement())
  cycle         Int
  fundamentalId Int
  description   String @db.Text

  fundamental FundamentalCompetence @relation(fields: [fundamentalId], references: [id], onDelete: Cascade)

  @@index([cycle, fundamentalId])
}
