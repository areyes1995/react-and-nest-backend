// ======================================================
// PREGUNTAS — el banco de preguntas de la academia
// ------------------------------------------------------
// A diferencia de las clases, las preguntas sí viven en
// la base: se cargan con el seeder (`pnpm db:seed`) y la
// IA puede añadir más. `slug` es la clave estable del
// seeder, así que volver a sembrar actualiza en vez de
// duplicar.
//
// `source` distingue el origen: LOCAL (seeder / banco
// propio) o AI. Lo generado por IA solo entra en la
// base si un administrador lo decide al revisarlo, y
// puede entrar publicado o como borrador.
// Las preguntas de IA publicadas dan XP ×2.
// ======================================================

model QuizQuestion {
  id Int @id @default(autoincrement())

  /** Clave estable. Las del seeder son legibles (`beg-rules-01`); las de IA, aleatorias. */
  slug String @unique @db.VarChar(120)

  level  QuizLevel
  format QuizQuestionFormat @default(MULTIPLE_CHOICE)

  /** Tema (`rules`, `position`, `math`…). Lista cerrada en `quiz.constants.ts`. */
  category String @db.VarChar(40)

  question String @db.Text

  /** Opciones en orden original (string[]). Se barajan al servirlas. */
  options     Json
  answerIndex Int

  /** Por qué la correcta es la correcta: se muestra siempre tras responder. */
  explanation String @db.Text

  // ── Situación opcional (formato SPOT) ──
  // Notación corta del motor: `As Kh`, `Td 9d 2c`.
  hole  String? @db.VarChar(20)
  board String? @db.VarChar(40)

  source    QuizQuestionSource @default(LOCAL)
  published Boolean            @default(true)

  /** Modelo que la generó, cuando `source = AI`. */
  aiModel String? @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, published])
  @@index([category])
}
