// ======================================================
// PLATAFORMA — usuario del sistema, auditoría, notificaciones
// ======================================================

model SystemUser {
  id         Int     @id @default(autoincrement())
  firstName  String  @db.VarChar(100)
  lastName   String  @db.VarChar(100)
  employeeId String? @db.VarChar(50)
  email      String  @unique @db.VarChar(150)

  passwordHash String @db.VarChar(255)

  phoneNumber String? @db.VarChar(25)
  isActive    Boolean @default(true)

  emailVerified     Boolean @default(false)
  mustChangePassword Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  systemLogs      SystemLog[]
  aiAnalysis      AiAnalysis[]
  notifications   Notification[]
  createdAuthLogs AuthLog[]        @relation("AuthLogCreatedBy")
  roles           SystemUserRole[]

  // Trading Risk Manager.
  tradingProfile    TradingProfile?
  fundingAccounts   FundingAccount[]
  tradeEntries      TradeEntry[]
  incomeEntries     IncomeEntry[]
  distributionPlans DistributionPlan[]
  payouts           Payout[]

  // Ajustes globales.
  appSettings AppSetting[] @relation("AppSettingUpdatedBy")

  @@index([isActive])
  @@index([firstName, lastName])
  @@index([employeeId])
}
