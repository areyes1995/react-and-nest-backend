// ======================================================
// PRISMA SCHEMA — MODU (multi-file: prisma/models)
// ------------------------------------------------------
// Convenciones:
//   * IDs: `BigInt` en tablas de datos; `Int` en la tabla de plataforma (`SystemUser`).
//   * Timestamps: `createdAt` / `updatedAt`; soft delete: `deletedAt`.
//   * Secretos: se cifran a nivel de aplicación (AES-256-GCM). El schema
//     solo guarda el ciphertext + versión de llave (NUNCA secretos en claro).
//   * Tablas vectoriales (RAG): NO gestionadas por migraciones Prisma;
//     se crean/restauran con el seeder `prisma/seeders/vector.seeder.ts`.
//   * Organización de archivos:
//       _base.prisma         → generator, datasource, convenciones
//       enums.prisma         → todos los enums, agrupados por dominio
//       <dominio>/*.prisma   → modelos agrupados por dominio
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
// ======================================================
// ENUMS — agrupados por dominio
// ======================================================

// ── Acceso y notificaciones ──────────────────────────

enum AuthEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
}

enum NotificationType {
  GENERIC
  INFO
  WARNING
  ERROR
}

// ── IA ───────────────────────────────────────────────

enum AiAnalysisType {
  VALIDATION_REQUEST_ITEM
  PENSUM_IMPORT
  STUDENT_SUBJECT_IMPORT
}

enum AiRecommendation {
  APPROVE
  REJECT
  REVIEW_MANUAL
}

enum AiAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ── Catálogos HR ─────────────────────────────────────

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  LICENSE
  INACTIVE
  TERMINATED
  PENDING
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  UNMATCHED
  ORPHAN
  DUPLICATE
}

enum AssignmentType {
  COACH
  MANAGER
  OTHER
}

// ── Turnover / Exits ─────────────────────────────────

enum ExitReasonCategory {
  CONTROLLABLE
  NON_CONTROLLABLE
}

enum ExitType {
  RESIGNATION
  TERMINATION
  REDUCTION
  RETIREMENT
  OTHER
}

enum SeparationOwnership {
  VOICE_TEAM
  CLIENT
  HR
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  ABANDONED
  WAIVED
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum QualityCheckStatus {
  OPEN
  RESOLVED
}

// ── Conexiones (APIs / bases de datos externas) ──────

enum ConnectionType {
  API
  DATABASE
}

enum ConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum ApiAuthType {
  NONE
  BEARER
  BASIC
  API_KEY
  OAUTH2
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MARIADB
  SQLSERVER
  ORACLE
  OTHER
}

// ── Sync / Ingestion ─────────────────────────────────

enum SyncSource {
  ODOO
  GENESYS
  KIMAI
  INTRANET
  OTHER
}

enum SyncType {
  PULL
  PUSH
  FULL
  INCREMENTAL
}

enum SyncTrigger {
  MANUAL
  CRON
  N8N
  API
}

enum SyncStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
  PARTIAL
}

enum StagingEmployeeStatus {
  NEW
  PROCESSED
  ERROR
  DUPLICATE
  ORPHAN
}

enum StagingExitStatus {
  NEW
  PROCESSED
  ERROR
  DUPLICATE
}

enum StagingGenesysStatus {
  NEW
  PROCESSED
  ERROR
  ORPHAN
}

// ======================================================
// CONEXIONES — APIs y bases de datos externas
// ======================================================

model Connection {
  id   BigInt        @id @default(autoincrement())
  name String        @db.VarChar(150)
  type ConnectionType
  status ConnectionStatus @default(ACTIVE)

  // ── API ──
  apiBaseUrl  String?      @db.VarChar(500)
  apiAuthType ApiAuthType?

  // ── Database ──
  databaseType DatabaseType?
  host         String?      @db.VarChar(255)
  port         Int?
  databaseName String?      @db.VarChar(150)
  username     String?      @db.VarChar(150)

  // ── Secretos (cifrado a nivel de aplicación) ──
  // `credentialsEncrypted`: ciphertext en base64 — AES-256-GCM
  //   formato: IV (12 bytes) || authTag (16 bytes) || ciphertext (JSON cifrado:
  //   password/token/apiKey/clientSecret…).
  // `encryptionKeyVersion`: versión de llave para rotación.
  credentialsEncrypted String? @db.Text
  encryptionKeyVersion String? @db.VarChar(50)

  // Configuración NO sensible (headers estáticos, opciones de conexión, etc.)
  extraConfig Json?

  lastTestedAt    DateTime?
  lastConnectedAt DateTime?

  createdById Int?
  createdBy   SystemUser? @relation(fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name])
  @@index([type, status])
  @@index([createdById])
}
// ======================================================
// CATÁLOGOS HR — organización, puestos, ubicaciones, plataformas
// ======================================================

model Organization {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(150)

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments       Department[]
  jobs              Job[]
  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@unique([name])
}

model Department {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String       @db.VarChar(150)
  odooId         Int?         @unique
  parentOdooId   Int?

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@index([organizationId])
  @@index([parentOdooId])
}

model Job {
  id             BigInt       @id @default(autoincrement())
  organizationId BigInt
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String       @db.VarChar(150)
  odooId         Int?         @unique

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@index([organizationId])
}

model Lob {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(150)

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@unique([name])
}

model Modality {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(80)

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@unique([name])
}

model WorkLocation {
  id       BigInt  @id @default(autoincrement())
  name     String  @db.VarChar(150)
  isRemote Boolean @default(false)

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees         Employee[]
  employmentHistory EmploymentHistory[]

  @@unique([name])
}

model Platform {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(100)

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employeeDetails    EmployeeDetail[]
  identityChangeLogs IdentityChangeLog[]
  syncJobs           SyncJob[]
  platformSyncLogs   PlatformSyncLog[]

  @@unique([name])
}
// ======================================================
// EMPLEADOS — detalle por plataforma y asignaciones
// ======================================================

model EmployeeDetail {
  id             BigInt   @id @default(autoincrement())
  employeeId     BigInt
  employee       Employee @relation(fields: [employeeId], references: [id])
  userPlatformId String   @db.VarChar(150) // ID del usuario en la plataforma externa
  platformId     BigInt
  platform       Platform @relation(fields: [platformId], references: [id])
  platformEmail  String?  @db.VarChar(255)

  status RecordStatus @default(ACTIVE)

  reconciliationStatus ReconciliationStatus @default(PENDING)
  source               SyncSource?
  lastSyncAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  syncLogs PlatformSyncLog[]

  @@unique([platformId, userPlatformId])
  @@index([employeeId])
  @@index([reconciliationStatus])
}

model Assignment {
  id                   BigInt    @id @default(autoincrement())
  employeeId           BigInt
  employee             Employee  @relation("AssignmentEmployee", fields: [employeeId], references: [id])
  supervisorEmployeeId BigInt?
  supervisor           Employee? @relation("AssignmentSupervisor", fields: [supervisorEmployeeId], references: [id])

  assignmentType AssignmentType
  status         RecordStatus   @default(ACTIVE)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@index([supervisorEmployeeId])
  @@index([assignmentType, status])
}
// ======================================================
// EMPLEADOS — identidad y equivalencia
// ======================================================

model Employee {
  id         BigInt  @id @default(autoincrement())
  odooId Int @unique
  employeeId String? @unique @db.VarChar(50) // ID legado/externo (ej. Odoo employee_code)
  name       String  @db.VarChar(200)
  email      String? @db.VarChar(255)

  jobId          BigInt?
  job            Job?          @relation(fields: [jobId], references: [id])
  departmentId   BigInt?
  department     Department?   @relation(fields: [departmentId], references: [id])
  organizationId BigInt?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  lobId          BigInt?
  lob            Lob?          @relation(fields: [lobId], references: [id])
  locationId     BigInt?
  location       WorkLocation? @relation(fields: [locationId], references: [id])
  modalityId     BigInt?
  modality       Modality?     @relation(fields: [modalityId], references: [id])

  hiredDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  status EmployeeStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  details               EmployeeDetail[]
  assignments           Assignment[]        @relation("AssignmentEmployee")
  supervisedAssignments Assignment[]        @relation("AssignmentSupervisor")
  employmentHistory     EmploymentHistory[]
  identityChangeLogs    IdentityChangeLog[]
  exits                 EmployeeExit[]
  systemUsers           SystemUser[]

  @@index([status])
  @@index([departmentId])
  @@index([organizationId])
  @@index([lobId])
  @@index([locationId])
}
// ======================================================
// EMPLEADOS — historial de empleo
// ======================================================

model EmploymentHistory {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt
  employee   Employee @relation(fields: [employeeId], references: [id])

  jobId          BigInt?
  job            Job?          @relation(fields: [jobId], references: [id])
  departmentId   BigInt?
  department     Department?   @relation(fields: [departmentId], references: [id])
  organizationId BigInt?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  lobId          BigInt?
  lob            Lob?          @relation(fields: [lobId], references: [id])
  locationId     BigInt?
  location       WorkLocation? @relation(fields: [locationId], references: [id])
  modalityId     BigInt?
  modality       Modality?     @relation(fields: [modalityId], references: [id])

  status EmployeeStatus?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  reason String? @db.VarChar(50) // hired, promotion, transfer, status_change, termination

  createdAt DateTime @default(now())

  @@index([employeeId, startDate])
}

model IdentityChangeLog {
  id           BigInt    @id @default(autoincrement())
  employeeId   BigInt
  employee     Employee  @relation(fields: [employeeId], references: [id])
  platformId   BigInt?
  platform     Platform? @relation(fields: [platformId], references: [id])
  fieldChanged String    @db.VarChar(100) // user_platform_id, platform_email, email, employee_id
  oldValue     String?   @db.Text
  newValue     String?   @db.Text
  source       SyncSource?

  changedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([employeeId])
}
// ======================================================
// TURNOVER / EXIT INSIGHTS (MVP)
// ======================================================

model ExitReason {
  id     BigInt  @id @default(autoincrement())
  odooId Int?    @unique
  name   String  @db.VarChar(150)
  code   String? @unique @db.VarChar(50)

  category ExitReasonCategory

  status RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  exits EmployeeExit[]
}

model EmployeeExit {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  exitDate   DateTime    @db.Date
  exitType   ExitType
  reasonId   BigInt?
  reason     ExitReason? @relation(fields: [reasonId], references: [id])
  reasonText String?     @db.Text

  createdBy String? @db.VarChar(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  interviews  ExitInterview[]
  actionItems ExitActionItem[]

  @@index([exitDate])
  @@index([exitType])
  @@index([reasonId])
}

model ExitInterview {
  id     BigInt       @id @default(autoincrement())
  exitId BigInt
  exit   EmployeeExit @relation(fields: [exitId], references: [id])

  scheduledAt DateTime?
  conductedAt DateTime?

  status      InterviewStatus @default(SCHEDULED)
  interviewer String?         @db.VarChar(150)
  findings    String?         @db.Text // DATOS SENSIBLES: acceso restringido

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([exitId])
  @@index([status])
}

model ExitActionItem {
  id     BigInt       @id @default(autoincrement())
  exitId BigInt
  exit   EmployeeExit @relation(fields: [exitId], references: [id])

  issue String  @db.VarChar(500)
  owner String? @db.VarChar(150)

  status  ActionItemStatus @default(OPEN)
  dueDate DateTime?        @db.Date
  notes   String?          @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([exitId])
  @@index([status, dueDate])
}

model DataQualityCheck {
  id       BigInt @id @default(autoincrement())
  entity   String @db.VarChar(50) // employee_exit, employee, employee_detail
  recordId BigInt

  missingFields Json?

  status     QualityCheckStatus @default(OPEN)
  checkedAt  DateTime           @default(now())
  resolvedAt DateTime?
  createdAt  DateTime           @default(now())

  @@unique([entity, recordId])
  @@index([status])
}
model AiAnalysis {
  id Int @id @default(autoincrement())

  analysisType AiAnalysisType

  analyzedById Int?
  analyzedBy   SystemUser? @relation(fields: [analyzedById], references: [id])

  provider      String? @db.VarChar(30)
  model         String  @db.VarChar(50)
  modelVersion  String? @db.VarChar(50)
  promptVersion String? @db.VarChar(20)

  prompt    Json
  response  Json
  inputHash String? @db.VarChar(64)

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCost    Decimal? @db.Decimal(10, 6)
  processingTimeMs Int?

  status       AiAnalysisStatus @default(COMPLETED)
  errorMessage String?          @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([analyzedById])
  @@index([status])
  @@index([createdAt])
  @@index([analysisType])
  @@index([inputHash])
}

model AuthLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   SystemUser? @relation("AuthLogCreatedBy", fields: [userId], references: [id])

  email String?   @db.VarChar(150)
  event AuthEvent

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([event])
  @@index([createdAt])
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   SystemUser @relation(fields: [userId], references: [id])

  type    NotificationType
  title   String           @db.VarChar(150)
  message String           @db.Text
  link    String?          @db.VarChar(255)

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ======================================================
// PLATAFORMA — RBAC: roles, recursos, permisos, asignaciones
// ------------------------------------------------------
// Roadmap (07-roadmap-todo.md §3.2): modelo de permisos
// granular. Los roles se siembran con el seeder
// (prisma/seeders/roles.seeder.ts) y son la única fuente
// de verdad: `SystemUser` se relaciona con `Role` vía la
// tabla N:N `SystemUserRole`.
// ======================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  permissions RolePermission[]
  users       SystemUserRole[]

  @@index([isActive])
}

model Resource {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String? @db.VarChar(255)

  permissions Permission[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  description String? @db.VarChar(255)
  resourceId  Int

  resource Resource @relation(fields: [resourceId], references: [id])
  roles    RolePermission[]

  @@index([resourceId])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SystemUserRole {
  userId Int
  roleId Int

  user SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SystemLog {
  id Int @id @default(autoincrement())

  userId Int?
  user   SystemUser? @relation(fields: [userId], references: [id])

  actionType String @db.VarChar(100)
  entityName String @db.VarChar(100)
  entityId   Int?

  oldValue String? @db.Text
  value    String? @db.Text

  ipAddress String? @db.VarChar(45)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([actionType])
  @@index([entityName, entityId])
  @@index([createdAt])
}

// ======================================================
// PLATAFORMA — usuario del sistema, auditoría, notificaciones
// ======================================================

model SystemUser {
  id         Int    @id @default(autoincrement())
  firstName  String @db.VarChar(100)
  lastName   String @db.VarChar(100)
  employeeId String? @unique @db.VarChar(50) // ID del empleado vinculado (Employee.employeeId)
  email      String @unique @db.VarChar(150)

  passwordHash String @db.VarChar(255)

  phoneNumber String?  @db.VarChar(25)
  isActive    Boolean  @default(true)

  emailVerified      Boolean @default(false)
  mustChangePassword Boolean @default(true)

  employee Employee? @relation(fields: [employeeId], references: [employeeId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  systemLogs      SystemLog[]
  aiAnalysis      AiAnalysis[]
  notifications   Notification[]
  createdAuthLogs AuthLog[]      @relation("AuthLogCreatedBy")
  connections     Connection[]
   roles           SystemUserRole[]

  // email y employeeId ya indexan por su UNIQUE; no hace falta índice adicional
  @@index([isActive])
  @@index([firstName, lastName])
}

// ======================================================
// RAG (tablas vectoriales)
