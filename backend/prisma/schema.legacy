// ======================================================
// SYNC / INGESTION — staging (payloads crudos de sistemas externos)
// ======================================================

model StagingEmployee {
  id                 BigInt    @id @default(autoincrement())
  source             SyncSource
  externalEmployeeId String    @db.VarChar(50)
  email              String?   @db.VarChar(255)

  rawPayload Json?

  status       StagingEmployeeStatus @default(NEW)
  errorMessage String?               @db.Text

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, status])
  @@index([externalEmployeeId])
}

model StagingExit {
  id                 BigInt    @id @default(autoincrement())
  source             SyncSource
  externalEmployeeId String    @db.VarChar(50)
  externalExitId     String?   @db.VarChar(50)

  exitDate DateTime? @db.Date
  exitType String?   @db.VarChar(50)
  reason   String?   @db.VarChar(150)

  rawPayload Json?

  status       StagingExitStatus @default(NEW)
  errorMessage String?           @db.Text

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, status])
  @@index([externalEmployeeId])
}

model StagingGenesysUser {
  id       BigInt  @id @default(autoincrement())
  userId   String  @unique @db.VarChar(100)
  email    String? @db.VarChar(255)
  fullName String? @db.VarChar(200)
  isActive Boolean @default(true)

  rawPayload Json?

  status       StagingGenesysStatus @default(NEW)
  errorMessage String?              @db.Text

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}
// ======================================================
// SYNC / INGESTION — jobs y logs de sincronización
// ======================================================

model SyncJob {
  id         BigInt   @id @default(autoincrement())
  platformId BigInt
  platform   Platform @relation(fields: [platformId], references: [id])

  syncType SyncType
  trigger  SyncTrigger @default(N8N)
  status   SyncStatus  @default(IN_PROGRESS)

  startedAt  DateTime?
  finishedAt DateTime?

  recordsProcessed Int @default(0)
  recordsCreated   Int @default(0)
  recordsUpdated   Int @default(0)
  recordsFailed    Int @default(0)

  summary      Json?
  errorMessage String? @db.Text
  initiatedBy  String? @db.VarChar(100)

  executionId BigInt? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([platformId])
}

model PlatformSyncLog {
  id         BigInt   @id @default(autoincrement())
  platformId BigInt
  platform   Platform @relation(fields: [platformId], references: [id])

  employeeDetailId BigInt?
  employeeDetail   EmployeeDetail? @relation(fields: [employeeDetailId], references: [id])

  syncType SyncType   @default(PULL)
  status   SyncStatus @default(IN_PROGRESS)

  startedAt  DateTime?
  finishedAt DateTime?

  recordsProcessed Int @default(0)
  recordsCreated   Int @default(0)
  recordsUpdated   Int @default(0)
  recordsFailed    Int @default(0)

  errorCode    String?   @db.VarChar(50)
  errorMessage String?   @db.Text
  responseCode Int? // Código HTTP del API
  payload      Json?
  syncToken    String?   @db.VarChar(255) // Cursor para paginación incremental
  initiatedBy  String?   @db.VarChar(100)
  lastSyncAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId, status])
  @@index([startedAt])
  @@index([employeeDetailId])
}