# ──────────────────────────────────────────────
# Uapaverse Frontend — Variables de Entorno
# ──────────────────────────────────────────────

# VITE_API_URL=http://localhost:3000/api/v1 #este se usa si se ejecuta por pnpm
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Uapaverse
VITE_TOKEN_EXPIRY_MINUTES=60
VITE_MOCK_ENABLED=true
VITE_MOCK_SECRET=uapaverse-dev-secret-2025

# ─── Método de autenticación ─────────────────
# db   → base de datos (endpoint /auth/login)
# ldap → LDAP/AD (endpoint /auth/ldap/login)
VITE_AUTH_METHOD=db

# ─── Configuración LDAP ──────────────────────
VITE_LDAP_DOMAIN=uapaverse.edu
VITE_LDAP_ALLOW_ANY_DOMAIN=false
VITE_LDAP_HOST=ldap.example.com
VITE_LDAP_PORT=389
VITE_LDAP_BASE_DN=dc=uapaverse,dc=edu
VITE_LDAP_BIND_DN=cn=admin,dc=uapaverse,dc=edu
VITE_LDAP_BIND_PASSWORD=admin-ldap-secret

# ─── Credenciales de prueba (mock LDAP) ──────
VITE_LDAP_MOCK_USER1=admin@uapaverse.edu
VITE_LDAP_MOCK_PASS1=Admin123!
VITE_LDAP_MOCK_USER2=maria.garcia@uapaverse.edu
VITE_LDAP_MOCK_PASS2=Maria2025!
VITE_LDAP_MOCK_USER3=carlos.lopez@uapaverse.edu
VITE_LDAP_MOCK_PASS3=Carlos2025!

# ─── Mesa de poker: rivales con IA ───────────
# El interruptor real está en el backend (POKER_AI_ENABLED). Esta variable solo
# decide qué opción viene preseleccionada en la mesa cuando la IA está
# disponible; si no lo está, se juega con los bots del motor.
VITE_POKER_AI_DEFAULT=false

# ─── Traducción del contenido ────────────────
# Servicio `translate/` (python3 translate/server.py o `docker compose up translate`).
# El contenido del backend llega en español y se traduce al idioma de Ajustes.
# Vacío = sin traducción (el contenido se ve en español).
VITE_TRANSLATE_URL=http://localhost:8010

# ─── Pagos / suscripciones (solo en modo mock) ──
# Con backend manda su .env (PAYMENTS_LIVE / PAYMENTS_PROVIDER).
# Vacías = MODO SIMULADO: el checkout activa la suscripción sin cobrar.
# VITE_PAYMENTS_LIVE=true o un proveedor activan los pagos reales; mientras
# la pasarela no esté integrada, el checkout NO completa compras.
VITE_PAYMENTS_LIVE=false
# stripe | paypal | google (vacío = ninguno)
VITE_PAYMENTS_PROVIDER=
